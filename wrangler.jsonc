{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skhrohoznik-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "ARCHIV",
      "id": "66634e03e12642eb95573800500b0baa"
    }
  ],
  "triggers": {
    "crons": ["7 * * * *"]
  }
}
